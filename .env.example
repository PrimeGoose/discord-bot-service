# ─────────────────────────────────────────────────────────────────────────────
# Server Toolkit — configuration
#
# DEMO_MODE=true needs NOTHING else: no Discord connection, seeded SQLite data,
# dashboard on http://localhost:3000.
#
# For a real deployment, create an application + bot in the Discord Developer
# Portal (https://discord.com/developers/applications), copy the *bot* token
# from the "Bot" tab and invite the bot with the `bot` + `applications.commands`
# scopes. Never use a user account token — this project is an official bot only.
# ─────────────────────────────────────────────────────────────────────────────

DEMO_MODE=true

# Official bot credentials (Developer Portal → your app). Required when DEMO_MODE=false.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands to one guild only (instant updates while developing).
DISCORD_DEV_GUILD_ID=

# SQLite file (created on first run). Use :memory: for throwaway runs.
DATABASE_PATH=./data/toolkit.db

# Admin dashboard. Set DASHBOARD_ENABLED=false to run the bot only.
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
# Optional HTTP Basic auth password for the dashboard (username: admin).
DASHBOARD_PASSWORD=

# How often the scheduler checks for due reminders / expired polls.
SCHEDULER_INTERVAL_MS=15000

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# pretty | json  (json is what you want in containers / log shippers)
LOG_FORMAT=pretty
