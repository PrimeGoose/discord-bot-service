{
  "name": "discord-bot-service",
  "version": "0.1.0",
  "private": true,
  "description": "Server Toolkit: an official Discord bot (discord.js v14, slash commands) with SQLite persistence, a demo mode that runs without a token, and a small admin dashboard.",
  "license": "MIT",
  "author": "Kaspars Bergs (https://github.com/PrimeGoose)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/index.ts",
    "demo": "tsx --disable-warning=ExperimentalWarning src/index.ts --demo",
    "demo:commands": "tsx --disable-warning=ExperimentalWarning src/demo/transcript.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "register": "tsx --disable-warning=ExperimentalWarning src/scripts/register-commands.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "discord.js": "^14.27.0",
    "hono": "^4.13.13",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
